# ===== prof-graph 环境配置模板 =====
# 复制为 .env 后填写实际值。.env 已被 git 忽略，勿提交真实 key。

# --- 数据库（T0 便携版 PostgreSQL）---
# 密码与端口对应 backend/scripts/setup_pg.sh 中 initdb 的设置
DATABASE_URL=postgresql+asyncpg://prof_graph:prof_graph_dev@localhost:5432/prof_graph
DATABASE_URL_TEST=postgresql+asyncpg://prof_graph:prof_graph_dev@localhost:5432/prof_graph_test

# --- GLM（Anthropic 协议接入，用户提供）---
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_REQUEST_TIMEOUT_MS=120000

# --- 熔断预算（T23 联调后按真实用量校准）---
TOKEN_BUDGET_DAILY=1200000
TOKEN_BUDGET_WEEKLY=6000000

# --- OpenAlex（免费，mailto 提高速率限制）---
OPENALEX_MAILTO=prof-graph@internal.example

# --- 采集 ---
ARXIV_RSS_BASE=https://export.arxiv.org/rss
# 近 N 天（小回灌窗口，T23 用）
BACKFILL_WINDOW_DAYS=5
